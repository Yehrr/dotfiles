#!/usr/bin/env bash
set -euo pipefail

IMAGE=pi-dock
NET=pi-dock-net
NETWORK="$NET"

usage() {
  cat <<EOF
Usage: pi-dock [-n network]

  -n network   Docker network to use (default: $NET, "host" for host networking)
  -h           Show this help
EOF
}

while getopts ":n:h" opt; do
  case "$opt" in
    n) NETWORK="$OPTARG" ;;
    h) usage; exit 0 ;;
    :) echo "Error: -${OPTARG} requires an argument" >&2; usage >&2; exit 1 ;;
    *) usage >&2; exit 1 ;;
  esac
done

# build image if not found
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  docker build -t "$IMAGE" -f "$SCRIPT_DIR/Dockerfile" "$SCRIPT_DIR"
fi

if [ "$NETWORK" = "host" ]; then
  # Host networking: the container shares the host's network stack
  HOST_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
  [ -n "$HOST_IP" ] || HOST_IP=127.0.0.1
else
  if ! docker network inspect "$NETWORK" >/dev/null 2>&1; then
    docker network create --internal "$NETWORK" >/dev/null
  fi

  # Host IP on the bridge side, exposed as a variable for the app inside the container
  HOST_IP=$(docker network inspect -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}' "$NETWORK")
fi

docker run --rm -it \
  --network "$NETWORK" \
  -e TERM=xterm-256color \
  -e HOST_IP="$HOST_IP" \
  -v "$PWD:/workspace" \
  -v pi-agent-home:/root/.pi/agent \
  $IMAGE
