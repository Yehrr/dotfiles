#!/usr/bin/env bash
set -euo pipefail

IMAGE=pi-dock
NET=pi-dock-net
NETWORK="$NET"
HOST_IP=127.0.0.1

usage() {
  cat <<EOF
Usage: pi-dock [-n]

  -n           Use "host" networking (default: $NET)
  -h           Show this help
EOF
}

while getopts ":nh" opt; do
  case "$opt" in
    n) NETWORK=host ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
done

# build image on every launch
# resolve symlinks so SCRIPT_DIR points to the real script location
SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
docker build -t "$IMAGE" -f "$SCRIPT_DIR/Dockerfile" "$SCRIPT_DIR"

if [ "$NETWORK" != "host" ]; then
  if ! docker network inspect "$NETWORK" >/dev/null 2>&1; then
    docker network create --internal "$NETWORK" >/dev/null
  fi

  # Host IP on the bridge side, exposed as a variable for the app inside the container
  HOST_IP=$(docker network inspect -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}' "$NETWORK")
fi

docker run --rm -it \
  --network "$NETWORK" \
  -e TERM=xterm-256color \
  -e HOST_IP="$HOST_IP" \
  -v "$PWD:/workspace" \
  -v pi-agent-home:/root/.pi/agent \
  -v /home/yehrol/.agents:/root/.agents \
  $IMAGE
